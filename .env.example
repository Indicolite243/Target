MYSQL_URL=jdbc:mysql://127.0.0.1:3306/stock_manager?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USERNAME=root
MYSQL_PASSWORD=请填写本机MySQL密码
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=请填写Redis随机密码
JWT_SECRET=请替换为至少32字节的随机密钥
QUANT_SERVICE_URL=http://127.0.0.1:8000/internal/v1
QUANT_INTERNAL_TOKEN=development-internal-token
QUANT_CONNECT_TIMEOUT_MS=500
QUANT_REALTIME_READ_TIMEOUT_MS=2000
QUANT_MODE=QMT
QUANT_QMT_PATH=D:/GuoJin_2nd/国金QMT交易端模拟/userdata_mini
QUANT_QMT_ACCOUNT_ID=请填写QMT资金账号
QUANT_QMT_ACCOUNT_TYPE=STOCK
QUANT_QMT_READ_ENABLED=true
QUANT_QMT_TRADE_ENABLED=false
MARKET_QUOTE_CACHE_TTL_MS=1000
PORTFOLIO_LIVE_ENABLED=true
PORTFOLIO_COLLECT_INTERVAL_MS=2000
PORTFOLIO_PERSIST_INTERVAL_MS=30000
PORTFOLIO_REDIS_TTL_SECONDS=10
PORTFOLIO_HISTORY_ENABLED=true
PORTFOLIO_HISTORY_ASSET_INTERVAL_MS=300000
PORTFOLIO_HISTORY_POSITION_INTERVAL_MS=900000
QUANT_TASK_CORE_POOL_SIZE=2
QUANT_TASK_MAX_POOL_SIZE=4
QUANT_TASK_QUEUE_CAPACITY=32
BACKTEST_STORAGE_ROOT=../runtime/backtests
BACKTEST_MAX_STRATEGY_BYTES=5242880
BACKTEST_MAX_MARKET_FILE_BYTES=20971520
BACKTEST_MAX_MARKET_TOTAL_BYTES=52428800
# Investment assistant: same Qwen model as the Agent learning project
DASHSCOPE_API_KEY=
# 可选：本地已有 DASHSCOPE_API_KEY 时可只引用对应 env 文件，生产环境不要使用个人路径。
ASSISTANT_LLM_CREDENTIALS_FILE=
ASSISTANT_LLM_MODEL=qwen3.7-plus
ASSISTANT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASSISTANT_LLM_TEMPERATURE=0.2
ASSISTANT_LLM_TIMEOUT_SECONDS=90
ASSISTANT_LLM_MAX_TOKENS=4096
# 默认由 FastAPI 的 LangChain create_agent 负责编排；紧急回滚可改为 legacy。
ASSISTANT_ENGINE=langchain
ASSISTANT_AGENT_MAX_MODEL_CALLS=3
ASSISTANT_AGENT_MAX_TOOL_CALLS=5
# 投研 Agent 的内部 MCP 服务。单体本地运行时保持默认即可；生产环境请设置独立随机令牌。
ASSISTANT_MCP_BASE_URL=http://127.0.0.1:8080
ASSISTANT_MCP_ENDPOINT=/internal/mcp
ASSISTANT_MCP_INTERNAL_TOKEN=development-internal-token
ASSISTANT_MCP_REQUEST_TIMEOUT_SECONDS=45
